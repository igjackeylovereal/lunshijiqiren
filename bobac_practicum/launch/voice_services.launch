<launch>
  <!-- Only services. The original integrated voice application can send velocity and is not launched. -->
  <node pkg="ifly_package" type="aiui_semantic" name="aiui_semantic" output="screen" />
  <node pkg="speech_synthesis" type="speech_synthesis" name="speech_synthesis" output="screen">
    <param name="tts_audio_file" value="$(env HOME)/bobac_practicum_run/tts.wav" />
  </node>
</launch>
